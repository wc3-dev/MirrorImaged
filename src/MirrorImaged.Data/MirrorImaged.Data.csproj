<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Reads Warcraft III maps and the game's data from your install. Part of MirrorImaged, a headless Warcraft III map runtime; its API is not covered by 1.0's compatibility promise and may change in any release. Reference MirrorImaged instead.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MirrorImaged.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="War3Net.Build.Core" />
    <PackageReference Include="War3Net.IO.Mpq" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Decks.txt" LogicalName="Decks.txt" />
    <EmbeddedResource Include="DecksClassic.txt" LogicalName="DecksClassic.txt" />
  </ItemGroup>

</Project>
