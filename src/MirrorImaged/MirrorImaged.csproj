<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Run Warcraft III maps (Lua or JASS) headless and test them from C#: a simulated world and clock with C# copies of the game's natives, the same result for the same map, seed and input. Needs Warcraft III installed.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MirrorImaged.Tests" />
    <InternalsVisibleTo Include="MirrorImaged.GameTests" />
    <InternalsVisibleTo Include="MirrorImaged.Cli" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="War3Net.CodeAnalysis.Transpilers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MirrorImaged.Data\MirrorImaged.Data.csproj" />
    <ProjectReference Include="..\MirrorImaged.Lua\MirrorImaged.Lua.csproj" />
    <ProjectReference Include="..\MirrorImaged.Natives\MirrorImaged.Natives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="viewer.html" LogicalName="MirrorImaged.viewer.html" />
  </ItemGroup>
</Project>
