<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mirror</ToolCommandName>
    <Description>The mirror command-line tool for MirrorImaged: runs, checks, tests, replays, compares and benchmarks Warcraft III maps headless against the game's natives. Needs Warcraft III installed.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MirrorImaged\MirrorImaged.csproj" />
  </ItemGroup>

</Project>
