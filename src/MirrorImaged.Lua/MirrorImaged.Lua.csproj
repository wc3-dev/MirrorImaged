<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Lua 5.3 with the game's numbers, for win-x64, linux-x64 and osx-arm64. Part of MirrorImaged, a headless Warcraft III map runtime; its API is not covered by 1.0's compatibility promise and may change in any release. Reference MirrorImaged instead.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MirrorImaged" />
    <InternalsVisibleTo Include="MirrorImaged.Natives" />
    <InternalsVisibleTo Include="MirrorImaged.Tests" />
  </ItemGroup>

  <!-- Built by native/build.ps1 and committed, so a plain dotnet build needs no zig. -->
  <ItemGroup>
    <None Include="runtimes\**" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes" />
  </ItemGroup>

</Project>
