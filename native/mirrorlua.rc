// The Windows library's version resource (D830).
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3F
FILEFLAGS 0
FILEOS 0x40004
FILETYPE 2
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "mdlsvensson"
            VALUE "FileDescription", "MirrorImaged Lua runtime (Lua 5.3.6)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "mirrorlua"
            VALUE "LegalCopyright", "Copyright (c) 2026 mdlsvensson. MIT License. Lua: Copyright (c) 1994-2020 Lua.org, PUC-Rio."
            VALUE "OriginalFilename", "mirrorlua.dll"
            VALUE "ProductName", "MirrorImaged"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
